# 复制为 server/.env 并填真实值(.env 已 gitignore,密码绝不入库)
# 连接的是 Docker 容器 bestfunc-postgres(postgres:16)里的独立库 sentinel
SENTINEL_DB_DSN=host=localhost port=5433 user=bestfunc password=<容器密码> dbname=sentinel sslmode=disable

# 可选覆盖
# SENTINEL_PORT=8787
# SENTINEL_PYTHON=/Users/lugia/lugia_fc/TradingAgents/.venv/bin/python

# DeepSeek(AI讲解;OpenAI兼容)
SENTINEL_DEEPSEEK_KEY=<你的deepseek key>
SENTINEL_DEEPSEEK_BASE=https://api.deepseek.com
SENTINEL_DEEPSEEK_MODEL=deepseek-chat
