# 复制为 server/.env 并填真实值(.env 已 gitignore,密钥绝不入库)
# ── 数据库(PostgreSQL 16+)──
SENTINEL_DB_DSN=host=localhost port=5432 user=sentinel password=<your-db-password> dbname=sentinel sslmode=disable

# ── 服务 ──
# SENTINEL_PORT=8787
# 引擎用的 Python(装了 pandas/numpy/pyarrow/baostock 等的解释器)
# SENTINEL_PYTHON=/path/to/venv/bin/python
# 引擎数据目录(默认 engine/data;放 daily/meta/alt 子目录)
# SENTINEL_DATA_DIR=/path/to/data

# ── AI 讲解(可选;OpenAI 兼容接口,如 DeepSeek)──
SENTINEL_DEEPSEEK_KEY=<your-api-key>
SENTINEL_DEEPSEEK_BASE=https://api.deepseek.com
SENTINEL_DEEPSEEK_MODEL=deepseek-chat

# ── 鉴权 ──
SENTINEL_JWT_SECRET=<openssl rand -hex 32>
SENTINEL_ADMIN_EMAIL=<admin@example.com>
SENTINEL_ADMIN_PASSWORD=<strong-password>

# ── A股另类数据(可选;事件/红利腿,tushare 官方或兼容代理)──
# SENTINEL_TS_URL=https://api.tushare.pro
# SENTINEL_TS_TOKEN=<your-tushare-token>

# ── 对象存储(可选;MinIO,用于新闻/研报附件)──
# SENTINEL_MINIO_ENDPOINT=localhost:9000
# SENTINEL_MINIO_KEY=<key>
# SENTINEL_MINIO_SECRET=<secret>
# SENTINEL_MINIO_BUCKET=sentinel
